---
import buyer from '../assets/buyer.png';
import seller from '../assets/sellers.png';
import delivery from '../assets/delivery.png';

const audiences = [
  {
    title: 'Shop local',
    label: 'For buyers',
    description: 'Find products from local stores and follow your order from checkout to delivery.',
    image: buyer,
    imageAlt: 'Shopyos for buyers',
    href: '/buyers',
    action: 'Explore shopping',
  },
  {
    title: 'Grow your store',
    label: 'For sellers',
    description: 'Set up your storefront and discover tools for products, inventory and orders.',
    image: seller,
    imageAlt: 'Shopyos for sellers',
    href: '/sellers',
    action: 'Explore selling',
  },
  {
    title: 'Deliver locally',
    label: 'For drivers',
    description: 'Learn how delivery partners can support local orders and register interest.',
    image: delivery,
    imageAlt: 'Shopyos for delivery partners',
    href: '/drivers',
    action: 'Explore delivery',
  },
];
---

<div class="mt-12 grid gap-5 md:grid-cols-3 md:gap-6">
  {audiences.map((audience) => (
    <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-1 hover:shadow-lg">
      <img
        src={audience.image.src}
        width={audience.image.width}
        height={audience.image.height}
        alt={audience.imageAlt}
        class="aspect-[1.9/1] w-full object-cover"
        loading="lazy"
      />
      <div class="flex flex-1 flex-col p-6 md:p-7">
        <p class="text-xs font-extrabold uppercase tracking-[.12em] text-lime-700">{audience.label}</p>
        <h3 class="mt-2 text-2xl font-extrabold text-navy">{audience.title}</h3>
        <p class="mt-3 flex-1 leading-relaxed text-slate-600">{audience.description}</p>
        <a href={audience.href} class="mt-6 inline-flex min-h-11 items-center gap-2 font-bold text-navy underline decoration-lime decoration-2 underline-offset-4 transition group-hover:text-lime-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4">
          {audience.action}
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </article>
  ))}
</div>
