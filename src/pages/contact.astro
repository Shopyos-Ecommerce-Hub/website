---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get Started with Shopyos">
  <section class="page-hero">
    <div class="mx-auto w-[min(1120px,calc(100%-40px))]">
      <p class="eyebrow">Get started</p>
      <h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Join the Shopyos journey.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">Whether you want to shop, sell, deliver or explore a commercial partnership, let us know how you’d like to be involved.</p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto grid w-[min(1120px,calc(100%-40px))] gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2 class="mt-3 text-4xl font-extrabold text-navy">Tell us what you’re interested in.</h2>
        <p id="contact-form-note" class="mt-4 leading-relaxed text-muted">This form opens your email app. The website does not collect the information you enter here.</p>
        <div class="mt-8 rounded-2xl border border-lime/30 bg-[#eff7e4]/60 p-5">
          <p class="text-xs font-extrabold uppercase tracking-wider text-[#4d7c0f]">Commercial &amp; Trading Partners</p>
          <p class="mt-2 text-sm leading-relaxed text-navy">Are you a retailer, wholesaler, or fleet operator looking to scale your trading services?</p>
          <a class="mt-3 inline-flex min-h-11 items-center gap-1 font-bold text-navy underline decoration-lime decoration-2 underline-offset-4 transition hover:text-lime-700" href="/partners">Partner with us now</a>
        </div>
      </div>

      <form class="grid content-start gap-5" action="mailto:hello@shopyos.com" method="post" enctype="text/plain" aria-describedby="contact-form-note">
        <label class="grid gap-2 font-bold text-navy" for="contact-name">
          Name
          <input id="contact-name" class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-ink" name="name" autocomplete="name" required />
        </label>
        <label class="grid gap-2 font-bold text-navy" for="contact-email">
          Email address
          <input id="contact-email" class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-ink" name="email" type="email" autocomplete="email" required />
        </label>
        <label class="grid gap-2 font-bold text-navy" for="contact-interest">
          I’m interested in
          <select id="contact-interest" class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-ink" name="interest">
            <option>Shopping with Shopyos</option>
            <option>Selling on Shopyos</option>
            <option>Commercial trading partnership</option>
            <option>Delivery &amp; fleet partnership</option>
            <option>Business or investment partnership</option>
          </select>
        </label>
        <button class="btn mt-1 w-full sm:w-fit" type="submit">Continue in email app</button>
      </form>
    </div>
  </section>
</BaseLayout>
