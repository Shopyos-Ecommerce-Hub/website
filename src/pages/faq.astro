---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  ['Where can I use Shopyos?', 'Shopyos is available on the web at app.shopyosgh.com and as an app on Google Play and the App Store.'],
  ['What payment methods are supported?', 'Available payment methods are shown during checkout and may vary by order.'],
  ['How does delivery work?', 'Shopyos supports local fulfilment with order and delivery-status updates for supported deliveries.'],
  ['Can I become a seller?', 'Yes. Sellers can register a business, create a store profile, manage products and handle orders on Shopyos.'],
  ['How do returns or support work?', 'Support and order-history tools help customers get assistance with an order. See our return policy for details.'],
  ['Is Shopyos secure?', 'Shopyos provides account and transaction safeguards, seller information and customer support tools.'],
];
---

<BaseLayout title="Shopyos FAQ">
  <section class="page-hero">
    <div class="mx-auto w-[min(1120px,calc(100%-40px))]">
      <p class="eyebrow">Frequently asked questions</p>
      <h1 class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Answers for shoppers, sellers and partners.</h1>
    </div>
  </section>
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-5">
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map(([question, answer], index) => (
          <details class="group py-2" open={index === 0}>
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-6 py-3 font-bold text-navy">
              {question}
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="max-w-2xl pb-5 leading-relaxed text-muted">{answer}</p>
          </details>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn" href="https://play.google.com/store/apps/details?id=com.eugeneanokye99.shopyos" target="_blank" rel="noopener noreferrer">Get it on Google Play</a>
        <a class="btn-dark" href="https://apps.apple.com/us/app/shopyos/id6807581845" target="_blank" rel="noopener noreferrer">Get it on the App Store</a>
        <a class="inline-flex min-h-11 items-center px-3 font-bold text-navy underline decoration-lime decoration-2 underline-offset-4" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">Open the web app</a>
      </div>
      <p class="mt-8 text-center text-sm text-muted">For delivery and return details, read our <a class="font-semibold text-navy underline decoration-lime underline-offset-4" href="/shipping">shipping policy</a> and <a class="font-semibold text-navy underline decoration-lime underline-offset-4" href="/returns">return policy</a>.</p>
    </div>
  </section>
</BaseLayout>
