---
import BaseLayout from '../layouts/BaseLayout.astro';
import EcosystemCards from '../components/EcosystemCards.astro';
import adaptiveIcon from '../assets/adaptive-icon.png';
import phone from '../assets/andriod_phone.png';
import googlePlayBadge from '../assets/store/GetItOnGooglePlay_Badge_Web_color_English.png';
import appStoreBadge from '../assets/store/US/Download_on_App_Store/White_lockup/SVG/Download_on_the_App_Store_Badge_US-UK_RGB_wht_092917.svg';
---

<BaseLayout title="Shopyos — Local commerce for Ghana">
  <section data-parallax class="bg-[#f6f8fa] py-14 md:py-20 lg:py-24">
    <div class="mx-auto grid w-[min(1240px,calc(100%-40px))] items-center gap-12 lg:grid-cols-[1.08fr_.92fr]">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#e0f3cb] px-3 py-1 text-xs font-extrabold uppercase tracking-[.13em] text-navy">
          <img src={adaptiveIcon.src} width={adaptiveIcon.width} height={adaptiveIcon.height} alt="" class="h-5 w-5 object-contain" />
          Now available on web, Google Play and the App Store
        </p>
        <h1 class="mt-6 max-w-2xl text-5xl font-extrabold leading-[1.08] tracking-[-.04em] text-navy sm:text-6xl lg:text-[4.15rem]">
          The Future of <span class="text-lime">Local Commerce</span> is Shopyos
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
          A seamless marketplace for buyers, sellers and delivery partners, built for the way Ghana shops and sells locally.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a class="btn min-h-12 min-w-52" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">Shop on Shopyos</a>
          <a class="font-bold text-navy underline decoration-lime decoration-2 underline-offset-4 transition hover:text-lime-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4" href="#ecosystem">Choose your path</a>
        </div>
        <p class="mt-5 text-sm text-slate-600">
          Looking to scale your trading services?
          <a href="/partners" class="ml-1 font-bold text-navy underline decoration-lime decoration-2 underline-offset-4 transition hover:text-lime-700">Partner with us</a>
        </p>
      </div>
      <div class="mx-auto w-[220px] sm:w-[260px] lg:w-[280px]">
        <div class="relative rounded-[2.75rem] bg-navy p-2 shadow-[0_25px_60px_-20px_rgba(16,35,95,.4)] transition duration-300 hover:-translate-y-1">
          <span class="absolute -left-1 top-24 h-8 w-1 rounded-l bg-[#0a1740]"></span>
          <span class="absolute -left-1 top-36 h-12 w-1 rounded-l bg-[#0a1740]"></span>
          <span class="absolute -right-1 top-28 h-16 w-1 rounded-r bg-[#0a1740]"></span>
          <div class="relative overflow-hidden rounded-[2.25rem] bg-white">
            <span class="absolute left-1/2 top-0 z-10 h-5 w-24 -translate-x-1/2 rounded-b-xl bg-navy"></span>
            <img src={phone.src} width={phone.width} height={phone.height} alt="Shopyos shopping app home screen" class="block w-full" />
          </div>
        </div>
        <p class="mt-4 text-center text-sm font-semibold text-slate-600">A closer look at the Shopyos shopping app</p>
      </div>
    </div>
  </section>

  <section id="ecosystem" class="bg-[#eef2f5] py-16 md:py-24">
    <div class="mx-auto w-[min(1120px,calc(100%-40px))]">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-4xl font-extrabold tracking-[-.03em] text-navy md:text-5xl">Find your place in local commerce.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Shop, grow a store, or support local deliveries. Choose the path that fits you.</p>
      </div>
      <EcosystemCards />
    </div>
  </section>

  <section class="bg-[#f8fafb] py-16 md:py-24">
    <div class="mx-auto grid w-[min(1120px,calc(100%-40px))] gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div class="max-w-md">
        <h2 class="text-4xl font-extrabold tracking-[-.03em] text-navy md:text-5xl">Technology that puts trust first.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Tools for safer transactions, clearer order updates and helpful support for the people who use Shopyos.</p>
        <a class="mt-7 inline-flex min-h-11 items-center font-bold text-navy underline decoration-lime decoration-2 underline-offset-4 transition hover:text-lime-700" href="/features">Explore Shopyos features</a>
      </div>

      <div class="grid gap-x-8 sm:grid-cols-2">
        <article class="border-t border-slate-300 py-6">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7 text-navy" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
          <h3 class="mt-4 text-lg font-bold text-navy">Account security</h3>
          <p class="mt-2 leading-relaxed text-slate-600">Built-in protections to keep your data and transactions safe.</p>
        </article>
        <article class="border-t border-slate-300 py-6">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7 text-navy" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h10v12H4z"/><path d="M14 10h3l3 3v5h-6"/><circle cx="8" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
          <h3 class="mt-4 text-lg font-bold text-navy">GPS tracking</h3>
          <p class="mt-2 leading-relaxed text-slate-600">Read precision real-time location updates from seller to doorstep.</p>
        </article>
        <article class="border-t border-slate-300 py-6">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7 text-navy" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M8 15h3"/></svg>
          <h3 class="mt-4 text-lg font-bold text-navy">Secure checkout</h3>
          <p class="mt-2 leading-relaxed text-slate-600">Designed for familiar payment methods and trusted local shopping.</p>
        </article>
        <article class="border-t border-slate-300 py-6">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7 text-navy" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8 8 0 0 1-3.5-.8L4 20l1.3-3.6A7.2 7.2 0 0 1 4 12c0-4.1 3.6-7.5 8-7.5s8 3.1 8 7Z"/><path d="M8 12h8M8 15h5"/></svg>
          <h3 class="mt-4 text-lg font-bold text-navy">Customer support</h3>
          <p class="mt-2 leading-relaxed text-slate-600">Get help when you need it with dedicated chat and support tools.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="download" class="bg-[#f8fafb] pb-12 md:pb-16">
    <div class="mx-auto grid w-[min(1120px,calc(100%-40px))] items-center gap-8 rounded-2xl bg-[radial-gradient(circle_at_85%_20%,rgba(132,204,22,.25),transparent_45%),linear-gradient(135deg,#10235f,#0a1740)] px-6 py-10 text-white md:grid-cols-[1fr_auto] md:px-10 md:py-12">
      <div>
        <h2 class="text-3xl font-extrabold leading-tight tracking-[-.03em] md:text-4xl">Shopyos is now live on iOS and Android.</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-slate-200">Get the app from Google Play or the App Store and start shopping, selling, or delivering with Shopyos.</p>
      </div>
      <div class="flex flex-wrap items-center gap-4 md:justify-end">
        <a href="https://play.google.com/store/apps/details?id=com.eugeneanokye99.shopyos" target="_blank" rel="noopener noreferrer" aria-label="Get Shopyos on Google Play">
          <img src={googlePlayBadge.src} width={googlePlayBadge.width} height={googlePlayBadge.height} alt="Get it on Google Play" class="h-[58px] w-auto object-contain md:h-16" />
        </a>
        <a href="https://apps.apple.com/us/app/shopyos/id6807581845" target="_blank" rel="noopener noreferrer" aria-label="Download Shopyos on the App Store">
          <img src={appStoreBadge.src} width="210" height="64" alt="Download on the App Store" class="h-[58px] w-auto object-contain md:h-16" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#f8fafb] pb-16 md:pb-24">
    <div class="mx-auto w-[min(1120px,calc(100%-40px))] rounded-2xl bg-[radial-gradient(circle_at_15%_80%,rgba(132,204,22,.2),transparent_45%),linear-gradient(135deg,#111965,#0a1740)] px-6 py-14 text-center text-white md:px-16 md:py-20">
      <h2 class="mx-auto max-w-2xl text-4xl font-extrabold tracking-[-.03em] md:text-6xl">Start trading on <span class="text-lime">Shopyos.</span></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-200">Download the app and join Ghanaian shoppers, sellers, and trade partners on Shopyos.</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <a class="btn min-h-12 min-w-52" href="#download">Get the apps</a>
        <a class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/20 bg-white/10 px-6 py-3 font-extrabold text-white transition hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy" href="/partners">Partner with us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const el = document.querySelector<HTMLElement>('[data-parallax]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !prefersReducedMotion) {
    let ticking = false;

    const update = () => {
      const rect = el.getBoundingClientRect();
      const progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
      const offset = (progress - 0.5) * 36;
      el.style.transform = `translateY(${offset}px)`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
