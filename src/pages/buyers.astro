---
import BaseLayout from '../layouts/BaseLayout.astro';
import phone from '../assets/andriod_phone.png';

const features = [
  ['Discover with ease', 'Search by product or category, browse stores and save items you love for later.'],
  ['Talk and negotiate', 'Chat with sellers and use offers where available to find the right deal.'],
  ['Checkout with confidence', 'Use familiar payment options and receive clear updates as your order progresses.'],
];
---

<BaseLayout title="Shop with Shopyos">
  <section class="page-hero">
    <div class="mx-auto grid w-[min(1120px,calc(100%-40px))] items-center gap-10 md:grid-cols-[1.1fr_.9fr] md:gap-14">
      <div>
        <p class="eyebrow">For shoppers</p>
        <h1 class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Discover more of what’s local.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">Browse products from local stores, talk to sellers, find deals and stay informed from checkout to delivery. Shop with Shopyos on the web or get the app for iOS and Android.</p>
        <a class="btn mt-8" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">Shop on Shopyos</a>
      </div>
      <figure class="mx-auto w-[200px] sm:w-[230px] md:w-[250px]">
        <div class="overflow-hidden rounded-[2.25rem] border-[7px] border-navy bg-white shadow-[0_20px_50px_-24px_rgba(16,35,95,.48)]">
          <img src={phone.src} width={phone.width} height={phone.height} alt="Shopyos shopping app home screen showing local products" class="block w-full" loading="eager" fetchpriority="high" />
        </div>
        <figcaption class="mt-4 text-center text-sm font-semibold text-slate-600">Browse local products in the Shopyos app</figcaption>
      </figure>
    </div>
  </section>
  <section class="py-16 md:py-20">
    <div class="mx-auto w-[min(1120px,calc(100%-40px))]">
      <h2 class="text-4xl font-extrabold text-navy">A better way to shop.</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {features.map(([title, copy]) => (
          <article class="card">
            <span aria-hidden="true" class="block h-1 w-10 rounded-full bg-lime"></span>
            <h3 class="mt-5 text-xl">{title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
