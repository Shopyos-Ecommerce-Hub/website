---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Shopyos">
  <section class="page-hero">
    <div class="mx-auto w-[min(1120px,calc(100%-40px))]">
      <p class="eyebrow">Local commerce, connected</p>
      <h1 class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Making everyday Ghanaian commerce easier.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        Shopyos connects shoppers, independent sellers and delivery partners in one useful marketplace experience. Shopyos is available on Android and iOS, with a <a class="font-bold text-navy underline decoration-lime decoration-2 underline-offset-4" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">web experience</a>.
      </p>
    </div>
  </section>
  <section class="py-16 md:py-20">
    <div class="mx-auto grid w-[min(1120px,calc(100%-40px))] items-start gap-10 md:grid-cols-2 md:gap-16">
      <div class="max-w-lg">
        <p class="eyebrow">Why Shopyos</p>
        <h2 class="mt-3 text-4xl font-extrabold text-navy">One place for the people who make local commerce move.</h2>
      </div>
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        <article class="py-6 md:py-8">
          <h3 class="text-xl font-bold text-navy">Our mission</h3>
          <p class="mt-3 leading-relaxed text-muted">Help Ghanaian shoppers buy with confidence and local businesses grow online with practical tools for stores, inventory, orders and promotions.</p>
        </article>
        <article class="py-6 md:py-8">
          <h3 class="text-xl font-bold text-navy">Our vision</h3>
          <p class="mt-3 leading-relaxed text-muted">A more connected local economy where great products, trustworthy sellers and dependable delivery are easier to find.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
